# Copy to .env. Never commit .env.
# DEFAULT PROVIDER = OpenRouter: one key, two vendors' models (fast = Claude Haiku, strong = GPT-4o).
OPENROUTER_API_KEY=

# Optional overrides, as "provider:model" (confirm exact slugs on openrouter.ai/models):
# LLM_FAST=openrouter:anthropic/claude-haiku-4.5
# LLM_STRONG=openrouter:openai/gpt-4o
# Optional: used automatically if the fast model errors (outage / rate limit)
# LLM_FALLBACK=openrouter:openai/gpt-4o-mini

# --- Opt-in: other providers (each key works ONLY for its own provider) ---
# LLM_PROVIDER=anthropic     # needs ANTHROPIC_API_KEY
# LLM_PROVIDER=openai        # needs OPENAI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Database (optional). Unset = local SQLite file at data/processed/dhaga.db.
# Supabase: Connect button -> use the *Session pooler* string (IPv4-friendly). See docs/04-database.md
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
