# Copy to .env for local runs. Never commit .env.
# Leave Supabase blank to run the CX module on local demo data (data/cx_demo/).
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_... (or legacy service_role JWT as SUPABASE_SERVICE_KEY)
KNOWLEDGE_BUCKET=Dhaga

# Leave blank to run Copilot in fallback mode (keyword intent + template replies).
ANTHROPIC_API_KEY=
# Or use OpenRouter instead (used when ANTHROPIC_API_KEY is blank)
OPENROUTER_API_KEY=

# Optional
# CX_DATA_SOURCE=auto          # auto | supabase | demo
# CX_TODAY=2026-07-05          # pretend "today" when computing delays on synthetic data
# MODEL_FAST=claude-haiku-4-5
# MODEL_STRONG=claude-opus-5-5

# Not used by the backend; checked by the Streamlit placeholder (app.py)
OPENAI_API_KEY=
